function parseSalary(salaryStr) {
    return Number(salaryStr.replace(/\D/g, ""));
}
var employeeList = document.querySelector("ul");
function sortList(listElement) {
    var items = Array.from(listElement.querySelectorAll("li"));
    items.sort(function(a, b) {
        var salaryA = parseSalary(a.dataset.salary);
        var salaryB = parseSalary(b.dataset.salary);
        return salaryB - salaryA;
    });
    items.forEach(function(item) {
        return listElement.appendChild(item);
    });
}
function getEmployees(listElement) {
    var items = listElement.querySelectorAll("li");
    return Array.from(items).map(function(li) {
        return {
            name: li.textContent.trim(),
            position: li.dataset.position,
            salary: parseSalary(li.dataset.salary),
            age: Number(li.dataset.age)
        };
    });
}
sortList(employeeList);
var employees = getEmployees(employeeList);
console.log(employees); // eslint-disable-line

